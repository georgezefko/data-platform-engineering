{
    "name": "local-kind-platform",
    "build": { "dockerfile": "Dockerfile" },
  
    "features": {
      "ghcr.io/devcontainers/features/docker-in-docker:2": {},
      "ghcr.io/devcontainers/features/github-cli:1": {},
      "ghcr.io/dhoeric/features/google-cloud-cli:1": {}
    },
    "forwardPorts": [8081],
    "portsAttributes": {
    "8081": { "label": "Argo CD UI" }
    },
  
    "containerEnv": {
      "KUBECONFIG": "/home/vscode/.kube/config"
    },
  
    "mounts": [
      "source=${localWorkspaceFolder}/.kube,target=/home/vscode/.kube,type=bind",
      // gcloud login from the Mac: Artifact Registry pulls (make airflow-image) + ADC (make airflow-secrets)
      "source=${localEnv:HOME}/.config/gcloud,target=/home/vscode/.config/gcloud,type=bind"
    ],
  
    "postCreateCommand": "bash scripts/check-tools.sh",
  
    "customizations": {
      "vscode": {
        "extensions": [
          "hashicorp.terraform",
          "ms-kubernetes-tools.vscode-kubernetes-tools",
          "redhat.vscode-yaml"
        ],
        "settings": {
          "terminal.integrated.defaultProfile.linux": "bash"
        }
      }
    }
  }
  